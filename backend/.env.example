# Server Port
PORT=3009

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/rhytmic_realm

# JWT Secret for Session & Socket Authentication
JWT_SECRET=rhytmic-realm-super-secret-key-change-in-production

# Frontend Client URLs for CORS
FRONTEND_URL=http://localhost:3003
MUSIC_PLAYER_URL=http://localhost:3000

# Redis Configuration (Optional: set ENABLE_REDIS=true for multi-node deployments)
ENABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Email Configuration (Optional for Password Reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
